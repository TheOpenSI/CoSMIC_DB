## Docker setup
DB_DIALECT=postgresql
DB_DRIVER=psycopg
DB_USER=demo
DB_PASSWORD=demo123
DB_HOST=database
DB_PORT=5432
DB_NAME=demo

# Set your OpenAI API key here
OPENAI_API_KEY=

# Auth BFF IAM management API (used to mirror user/role mutations into the IAM)
COSMIC_AUTH_URL=http://cosmic-keycloak-fastapi:8081


